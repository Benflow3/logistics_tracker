{
  "name": "logistics-tracker",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "forwardPorts": [8000, 5432],
  "portsAttributes": {
    "8000": {
      "label": "Logistics Tracker API"
    },
    "5432": {
      "label": "PostgreSQL"
    }
  },
  "postCreateCommand": "python -m pip install --user -r requirements-dev.txt"
}
